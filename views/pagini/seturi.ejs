<!DOCTYPE html>
<html lang="ro">
<head>
    <%- include("../fragmente/head") %>     
    <title>Seturi de Produse</title>
</head>
<body>
<%- include("../fragmente/header") %>

<main class="pag-seturi">
    <section id="seturi-section">
        <h2 class="titlu">Seturi de Plante</h1>
        <div class="lista-seturi">
                <% for(let set of seturi) { %>
                    <article class="box-set">
                        
                        <div class="info-set">
                            <div>
                                <h2 class="nume-set"><%= set.nume %></h2>
                                <p class="descriere-set"><%= set.descriere %></p>
                            </div>
                            
                            <div class="zona-preturi">
                                <p>
                                    <strong>Preț produse separat:</strong> 
                                    <span class="pret-vechi"><%= set.pretIntreg %></span> RON
                                </p>
                                <p>
                                    <strong>Preț pachet:</strong> 
                                    <span class="pret-nou"><%= set.pretRedus %></span> RON
                                </p>
                            </div>
                        </div>
                        
                        <div class="produse-set">
                            <h4>Plante incluse în set:</h4>
                            <div class="grid-mini-produse">
                                <% for(let prod of set.produse) { %>
                                    <div class="mini-produs">
                                        <a href="/produs/<%= prod.id %>">
                                            <figure>
                                                <img src="/resurse/imagini/produse/<%= prod.imagine %>" alt="[imagine <%= prod.nume %>]" />
                                            </figure>
                                            <div>
                                                <div class="mini-nume" title="<%= prod.nume %>"><%= prod.nume %></div>
                                                <div class="mini-pret"><%= prod.pret %> RON</div>
                                            </div>
                                        </a>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                    </article>
                <% } %>
            </div>
    </section>
</main>

<%- include("../fragmente/footer") %>
</body>
</html>