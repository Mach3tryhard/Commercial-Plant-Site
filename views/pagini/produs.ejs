<!DOCTYPE html>
<html lang="ro">
<head>
    <meta name="description" content="Detalii despre <%- locals.prod.nume %> - Magazinul nostru oferă plante de interior, exotice și decorative.">
    <meta name="keywords" content="plante, <%- locals.prod.categorie %>, <%- locals.prod.nume %>, <%- locals.prod.culoare_principala %>">
    
    <title>Magazin Plante - <%- locals.prod.nume %></title>
    <%- include("../fragmente/head") %>     

</head>
<body>
<%- include("../fragmente/header") %>

<main class="pag-produs">
    <div class="container-produs">
        
        <div class="zona-media">
            <div class="rama-carusel d-flex justify-content-center align-items-center">
                <% if (locals.imaginiProdus && locals.imaginiProdus.length > 0) { %>
                    <div id="caruselProdus" class="carousel slide w-100" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            
                            <div class="carousel-item active">
                                <img src="/resurse/imagini/produse/<%= locals.prod.imagine %>" class="d-block w-100" alt="Imagine principală <%= locals.prod.nume %>">
                            </div>
                            
                            <% for(let i = 0; i < imaginiProdus.length; i++) { %>
                                <div class="carousel-item">
                                    <img src="/resurse/imagini/produse/multe/<%= idProdus %>/<%= imaginiProdus[i] %>" class="d-block w-100" alt="Imagine extra <%= i + 1 %>">
                                </div>
                            <% } %>
                        </div>

                        <button class="carousel-control-prev" type="button" data-bs-target="#caruselProdus" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
                            <span class="visually-hidden">Precedent</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#caruselProdus" data-bs-slide="next">
                            <span class="carousel-control-next-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
                            <span class="visually-hidden">Următor</span>
                        </button>
                    </div>
                <% } else { %>
                    <img src="/resurse/imagini/produse/<%= locals.prod.imagine %>" class="img-fluid d-block" alt="<%= locals.prod.nume %>">
                <% } %>
            </div>
        </div>

        <div class="zona-detalii">
            <h2 class="titlu"><%- locals.prod.nume %></h1>
            <p class="descriere-produs"><%- locals.prod.descriere %></p>
            
            <div class="grid-specificatii">
                <div class="item-specificatie">
                    <strong>Categorie</strong>
                    <%- locals.prod.categorie %>
                </div>
                <div class="item-specificatie">
                    <strong>Înălțime</strong>
                    <%- locals.prod.inaltime_cm %> cm
                </div>
                <div class="item-specificatie">
                    <strong>Culoare Principală</strong>
                    <%- locals.prod.culoare_principala %>
                </div>
                <div class="item-specificatie">
                    <strong>Mod Prezentare</strong>
                    <%- locals.prod.prezentare %>
                </div>
                <div class="item-specificatie">
                    <strong>Toxic pentru animale</strong>
                    <%- locals.prod.toxic_animale ? "DA" : "NU" %>
                </div>
            </div>

            <div class="zona-cumparare">
                <div class="eticheta-pret"><%- locals.prod.pret %> RON</div>
                
                <div>
                    <input type="checkbox" class="btn-check select-cos" id="cos_<%- locals.prod.id %>" value="<%- locals.prod.id %>" autocomplete="off">
                    <label class="btn btn-info w-100 fw-bold border-dark py-2" for="cos_<%- locals.prod.id %>">
                        Adaugă în coșul de cumpărături
                    </label>
                </div>
            </div>
        </div>

    </div>

    <section class="sectiune-seturi-produs">
        <h2 class="titlu">Disponibil în următoarele seturi promoționale</h2>
        
        <% if(locals.seturi && locals.seturi.length > 0) { %>
            <div class="grid-seturi-produs">
                <% for(let set of locals.seturi) { %>
                    <div class="box-set-produs">
                        <div>
                            <h4 class="fw-bold text-uppercase mb-1" style="font-size: 1.1rem;"><%= set.nume %></h4>
                            <p class="small text-muted mb-2"><%= set.descriere %></p>
                            <p class="fw-bold text-danger mb-3" style="font-size: 1.05rem;">Preț pachet: <%= set.pretRedus %> RON</p>
                        </div>
                        
                        <div>
                            <h5 class="text-uppercase fw-bold text-muted small mb-2" style="font-size: 0.75rem; border-bottom: 1px solid var(--culoare-contur);">Componența setului:</h5>
                            <div class="componenta-set-imagini">
                                <% for(let prodSet of set.produse) { %>
                                    <div class="avatar-planta-set">
                                        <a href="/produs/<%= prodSet.id %>">
                                            <img src="/resurse/imagini/produse/<%= prodSet.imagine %>" alt="<%= prodSet.nume %>">
                                            <div class="text-truncate fw-bold text-dark mt-1" style="font-size: 0.7rem;" title="<%= prodSet.nume %>"><%= prodSet.nume %></div>
                                        </a>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <p class="text-muted small">Acest produs nu este inclus în niciun set promoțional momentan.</p>
        <% } %>
    </section>
</main>

<%- include("../fragmente/footer") %>
</body>
</html>