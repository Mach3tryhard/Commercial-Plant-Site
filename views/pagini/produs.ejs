<!DOCTYPE html>
<html lang="ro">
    <head>
        <meta name="description" content="Detalii despre <%- locals.prod.nume %> - Magazinul nostru oferă plante de interior, exotice și decorative.">
        <!-- Am adăugat keywords dinamice pentru SEO -->
        <meta name="keywords" content="plante, <%- locals.prod.categorie %>, <%- locals.prod.nume %>, <%- locals.prod.culoare_principala %>">
        
        <title>Magazin Plante - <%- locals.prod.nume %></title>
        <%- include("../fragmente/head") %>     
        <link href="/resurse/css/produs.css" type="text/css" rel="stylesheet" />
    </head>
    <body>
        <%- include("../fragmente/header") %>

    <main>
        <section>
            <h2>Detalii Plantă</h2>
            <article id="art-produs">
                <h3><span class="nume"><%- locals.prod.nume %></span></h3> 
                
                <div class="info-container">
                    <p><strong>Preț:</strong> <span class="pret"><%- locals.prod.pret %> RON</span></p>
                    <p><strong>Descriere:</strong> <span class="descriere"><%- locals.prod.descriere %> </span></p>
                    
                    <p><strong>Înălțime:</strong> <span class="inaltime"><%- locals.prod.inaltime_cm %> cm</span></p>
                    <p><strong>Categorie:</strong> <span class="categorie"><%- locals.prod.categorie %> </span></p>
                    <p><strong>Mod prezentare:</strong> <span class="prezentare"><%- locals.prod.prezentare %> </span></p>
                    <p><strong>Condiții îngrijire:</strong> <span class="ingrediente"><%- locals.prod.conditii_ingrijire %> </span></p>
                    <p><strong>Culoare principală:</strong> <span class="culoare"><%- locals.prod.culoare_principala %> </span></p>
                    <p><strong>Toxic animale:</strong> 
                        <span class="toxic_animale">
                            <%- locals.prod.toxic_animale ? "Da" : "Nu" %> 
                        </span>
                    </p>
                    
                    <p><strong>În ofertă din data:</strong> 
                        <span class="data">
                            <% 
                               let d = new Date(locals.prod.data_adaugare);
                               let data_formatata = d.getDate() + "-" + (d.getMonth() + 1) + "-" + d.getFullYear();
                            %>
                            <%- data_formatata %>
                        </span>
                    </p>
                </div>

                <figure class="imag-produs">
                    <img src="/resurse/imagini/produse/<%- locals.prod.imagine %>" alt="[imagine <%- locals.prod.nume %>]" style="max-width:400px; height:auto;"/>
                </figure>
                <!-- BONUS9 ETAPA 6 -->
                <div id="caruselProdus" class="carousel slide" data-bs-ride="carousel">
    
                    <div class="carousel-indicators">
                        <% for(let i = 0; i < imaginiProdus.length; i++) { %>
                            <button type="button" data-bs-target="#caruselProdus" data-bs-slide-to="<%= i %>" class="<%= i === 0 ? 'active' : '' %>" aria-current="<%= i === 0 ? 'true' : 'false' %>" aria-label="Slide <%= i + 1 %>"></button>
                        <% } %>
                    </div>

                    <div class="carousel-inner rounded border border-dark">
                        <% for(let i = 0; i < imaginiProdus.length; i++) { %>
                            <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
                                <img src="/resurse/imagini/produse/multe/<%= idProdus %>/<%= imaginiProdus[i] %>" class="d-block w-100" style="max-height: 400px; object-fit: contain;" alt="Imagine produs <%= i + 1 %>">
                            </div>
                        <% } %>
                    </div>

                    <% if (imaginiProdus.length > 1) { %>
                        <button class="carousel-control-prev" type="button" data-bs-target="#caruselProdus" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#caruselProdus" data-bs-slide="next">
                            <span class="carousel-control-next-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    <% } %>
                </div>
            </article>
        </section>
        <section class="mt-5 border-top border-dark pt-4">
            <h3 class="fw-bold mb-4">Disponibil în următoarele seturi promoționale:</h3>
            <% if(locals.seturi && locals.seturi.length > 0) { %>
                <div class="row row-cols-1 row-cols-md-2 g-4">
                    <% for(let set of locals.seturi) { %>
                        <div class="col">
                            <div class="p-3 border border-dark rounded shadow-sm h-100" style="background-color: var(--culoare-4);">
                                <h4 class="fw-bold text-dark mb-1"><%= set.nume %></h4>
                                <p class="small text-dark mb-2"><%= set.descriere %></p>
                                <p class="fw-bold text-danger mb-3">Preț pachet: <%= set.pretRedus %> RON</p>
                                
                                <h5 class="h6 text-muted small text-uppercase fw-bold mb-2">Componența setului:</h5>
                                <div class="d-flex gap-2">
                                    <% for(let prodSet of set.produse) { %>
                                        <div class="bg-white p-2 border rounded text-center" style="width: 90px;">
                                            <a href="/produs/<%= prodSet.id %>" class="text-decoration-none text-dark small">
                                                <img src="/resurse/imagini/produse/<%= prodSet.imagine %>" alt="<%= prodSet.nume %>" class="img-fluid mb-1" style="height: 45px; object-fit: contain;">
                                                <div class="text-truncate fw-bold" style="font-size: 0.75rem;"><%= prodSet.nume %></div>
                                            </a>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <p class="text-muted small">Acest produs nu este inclus în niciun set promoțional momentan.</p>
            <% } %>
        </section>
    </main>

    <%- include("../fragmente/footer") %>
    </body>
</html>