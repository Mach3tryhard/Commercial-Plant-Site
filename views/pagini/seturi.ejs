<!DOCTYPE html>
<html lang="ro">
<head>
    <%- include("../fragmente/head") %>     
    <title>Seturi de Produse</title>
</head>
<body>
<%- include("../fragmente/header") %>

<main class="container py-4">
    <section id="seturi" class="p-4 rounded-4 border border-dark">
        <h2 class="titlu text-center mb-4">Seturi de Plante</h2>
        
        <div class="row row-cols-1 g-4">
            <% for(let set of seturi) { %>
                <div class="col">
                    <article class="produs d-flex flex-column flex-md-row p-3 overflow-hidden shadow border border-dark justify-content-between gap-4">
                        
                        <div class="flex-grow-1">
                            <h3 class="nume h5 fw-bolder text-uppercase pb-2 border-bottom border-dark mb-3">
                                <%= set.nume %>
                            </h3>
                            
                            <p class="descriere mb-3 small text-dark"><%= set.descriere %></p>
                            
                            <div class="px-0 pb-2 pt-2 border-top border-dark mt-auto">
                                <p class="mb-1 small text-muted">
                                    <strong>Preț produse separat:</strong> 
                                    <span class="text-decoration-line-through"><%= set.pretIntreg %></span> RON
                                </p>
                                <p class="mb-0 fw-bold">
                                    <strong>Preț pachet:</strong> 
                                    <span class="text-danger"><%= set.pretRedus %></span> RON
                                </p>
                            </div>
                        </div>
                        
                        <div class="pt-3 pt-md-0 ps-md-4 border-md-start border-dark" style="min-width: 280px;">
                            <h4 class="h6 fw-bold text-uppercase pb-2 border-bottom border-dark mb-3">Plante incluse:</h4>
                            <div class="d-flex flex-wrap gap-2">
                                <% for(let prod of set.produse) { %>
                                    <div class="p-2 border border-dark bg-white text-center" style="width: 120px;">
                                        <a href="/produs/<%= prod.id %>" class="text-decoration-none text-dark">
                                            <figure class="mb-1 text-center">
                                                <img src="/resurse/imagini/produse/<%= prod.imagine %>" class="img-fluid" style="max-height: 70px; object-fit: contain;" alt="[imagine <%= prod.nume %>]" />
                                            </figure>
                                            <div class="fw-bold small text-truncate"><%= prod.nume %></div>
                                            <div class="text-muted small"><%= prod.pret %> RON</div>
                                        </a>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                    </article>
                </div>
            <% } %>
        </div>
    </section>
</main>

<%- include("../fragmente/footer") %>
</body>
</html>